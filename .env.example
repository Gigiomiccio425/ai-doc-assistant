# Copiare in .env accanto al docker-compose.yml e adattare i percorsi.

# --- Percorsi host (Zima OS / CasaOS) --------------------------------------
# Cartella del NAS da indicizzare (montata in sola lettura nel container).
DOCUMENTS_PATH=/DATA/Documents
# Dati persistenti dell'app: vector DB, anagrafica, file caricati dalla UI.
APPDATA_PATH=/DATA/AppData/ai-doc-assistant

# --- Versione dell'immagine -------------------------------------------------
# Tag pubblicati su ghcr.io/gigiomiccio425/ai-doc-assistant:
#   X.Y.Z  release stabile (consigliato)
#   X.Y    ultima patch della minor
#   latest ultimo commit su main
APP_VERSION=1.0.0

# --- Rete -------------------------------------------------------------------
WEBUI_PORT=8088
OLLAMA_PORT=11434

# --- Ollama -----------------------------------------------------------------
# Con il container Ollama incluso nel compose:
OLLAMA_URL=http://ollama:11434
# Con Ollama gia' attivo sull'host Zima:
# OLLAMA_URL=http://host.docker.internal:11434

LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# Scansione completa della cartella all'avvio del container.
SCAN_ON_START=true
